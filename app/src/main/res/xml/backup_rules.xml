<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 (minSdk 30) auto backup: same exclusions as data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="external" path="recordings" />
    <exclude domain="external" path="recipes" />
    <exclude domain="external" path="runs" />
    <exclude domain="external" path="dumps" />
    <exclude domain="external" path="events.log" />
    <exclude domain="external" path="debug-tree.txt" />
    <exclude domain="file" path="chats" />
    <exclude domain="file" path="chat.txt" />
</full-backup-content>
