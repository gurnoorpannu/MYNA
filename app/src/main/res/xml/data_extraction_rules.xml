<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup and device transfer. MYNA's data is personal: demo recordings hold screen text, recipes and run
   logs hold what was ordered and where, chats hold what the user said. None of it leaves the phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="recordings" />
        <exclude domain="external" path="recipes" />
        <exclude domain="external" path="runs" />
        <exclude domain="external" path="dumps" />
        <exclude domain="external" path="events.log" />
        <exclude domain="external" path="debug-tree.txt" />
        <exclude domain="file" path="chats" />
        <exclude domain="file" path="chat.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="recordings" />
        <exclude domain="external" path="recipes" />
        <exclude domain="external" path="runs" />
        <exclude domain="external" path="dumps" />
        <exclude domain="external" path="events.log" />
        <exclude domain="external" path="debug-tree.txt" />
        <exclude domain="file" path="chats" />
        <exclude domain="file" path="chat.txt" />
    </device-transfer>
</data-extraction-rules>
